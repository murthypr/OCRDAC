[OCRDAC]
# Mode: "dry-run" (scan only) or "prod" (scan + convert)
mode = prod

# Progress reporting interval (files per update)
progress_interval = 25

# Directory to scan for PDFs (relative to script or absolute)
directory = ./original_pdf_files

# Output directory for converted PDFs (empty = overwrite in place)
output_dir = ./ocred_output_files

# OCR language(s) - comma separated (e.g., eng, eng+fra, deu)
ocr_languages = eng

# Output file for names of already-OCR'd PDF files
ocr_output_file = ocr_files.txt

# Output file for names of PDF files needing OCR
non_ocr_output_file = non_ocr_files.txt

# Extra OCRmyPDF command-line parameters (space separated, pass-through).
# Examples: --verbose | --verbose --optimize 3 | --jbig2-lossy
#           --optimize 3 | --image-dpi 300 --optimize 3 --verbose
ocrmypdf_params = "--verbose --jbig2-lossy --optimize 3 --oversample 150"

# Preprocessing: "none" (default) or "median"
# Used as manual override when auto_preprocessing=false
preprocessing = "none"

# Auto-preprocessing: when true, OCRDAC analyzes each page image and
# applies median filtering + threshold only to pages that need it
# (low contrast, stripes, uneven background). When false, uses the
# preprocessing setting above.
auto_preprocessing = true

# Already-OCR'd PDFs: when true, copy them to the output directory
# (and list them in ocr_files.txt). When false, skip them entirely.
copy_already_ocred_files = true

# preserve_original_pdf:
#   When true, OCRDAC will graft OCR text onto the original PDF without
#   rasterizing or altering the original page images. This preserves
#   magazine clippings, charts, graphs, and high-quality scans.
#
#   When false, OCRDAC will use the legacy Ghostscript-based pipeline
#   which rasterizes pages and may degrade quality.
#
#   Default: true
preserve_original_pdf = true

# invisible_text_layer:
#   When true, OCRDAC inserts OCR text using PDF rendering mode 3,
#   making the text invisible while still searchable.
#   Default: true
invisible_text_layer = true

# Median filter kernel size (odd number, higher = stronger stripe removal)
median_filter_size = 3

# Binarization threshold (0-255, lower = more aggressive)
threshold = 130

# OCRDAC version identifier (written into PDF metadata)
ocrdac_version = v0.5
