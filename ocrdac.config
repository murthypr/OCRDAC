[OCRDAC]
# Mode: "dry-run" (scan only) or "prod" (scan + convert)
mode = prod

# Directory to scan for PDFs (relative to script or absolute)
# directory = "/mnt/e/NAS Backup/My Documents/Cars/2005 - Prius v2/"
directory = "./original_pdf_files"

# Output directory for converted PDFs (empty = overwrite in place)
output_dir = ./ocred_output_files

# OCR language(s) - comma separated (e.g., eng, eng+fra, deu)
ocr_languages = eng

# Additional OCRmyPDF options (see ocrmypdf --help)
ocrmypdf_options = --deskew --clean

# Output file for already-OCR'd PDFs
ocr_output_file = ocr_files.txt

# Output file for PDFs needing OCR
non_ocr_output_file = non_ocr_files.txt

# Progress reporting interval (files per update)
progress_interval = 25

# Prod mode options:
# Overwrite existing output files
overwrite = false

# Skip files that already have text layer (in prod mode)
skip_existing_ocr = true

# Preprocessing: "none" (default) or "median" (removes scan-line stripes)
# Use "median" for scans with horizontal gray stripe artifacts
preprocessing = median

# Auto-preprocessing: when true, OCRDAC analyzes each page image and
# applies median filtering only to pages that need it (low contrast,
# stripes, uneven background). When false, uses the preprocessing setting above.
auto_preprocessing = true

# Median filter kernel size (odd number, higher = stronger stripe removal)
median_filter_size = 3

# Binarization threshold (0-255, lower = more aggressive)
# Only used when preprocessing = median
threshold = 130

# OCRDAC version identifier (written into PDF metadata)
ocrdac_version = v0.2
